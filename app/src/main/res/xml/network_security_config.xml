<?xml version="1.0" encoding="utf-8"?>
<!--
  The app talks plain HTTP to its own process on 127.0.0.1. Everything else must
  be TLS. usesCleartextTraffic="false" in the manifest plus this allowlist is the
  narrow form: a global cleartext permit would also let the WebView load
  http:// pages from anywhere.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
